# Environment Configuration for ApprovalFlow Agent

# Database: SQLite for instant local zero-config testing or PostgreSQL for production/docker
DATABASE_URL=sqlite:///./approvalflow.db
# DATABASE_URL=postgresql://approvalflow:approvalflow@localhost:5432/approvalflow

# Security & Authorization
API_KEY=test-admin-secret-key
REQUIRE_AUTH=true

# Server Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=true

# External Action Sandbox / Email Provider (options: sandbox, smtp)
EMAIL_PROVIDER=sandbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=agent@approvalflow.internal

# LLM Provider Configuration (options: heuristic, openai, anthropic, gemini)
# Default 'heuristic' requires zero external API keys and generates rich, realistic research and outreach
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
